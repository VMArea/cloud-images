#!/usr/bin/env bash
set -euo pipefail
. "$(dirname "$0")/lib.sh"
need cosign sha256sum
dir=${1:?usage: sign <release-dir>}
KEYDIR=${COSIGN_KEYDIR:-$HOME/.cosign}

if [ ! -f "$KEYDIR/cosign.key" ]; then
  mkdir -p "$KEYDIR"; chmod 700 "$KEYDIR"
  if [ ! -f "$KEYDIR/password" ]; then
    (umask 077; head -c 24 /dev/urandom | base64 > "$KEYDIR/password")
  fi
  (cd "$KEYDIR" && COSIGN_PASSWORD=$(cat password) cosign generate-key-pair >/dev/null)
  chmod 600 "$KEYDIR/cosign.key"
  cp "$KEYDIR/cosign.pub" "$HERE/cosign.pub"
  echo "generated key pair in $KEYDIR; commit publish/cosign.pub only"
fi
[ "$(stat -c %a "$KEYDIR/password")" = 600 ] || die "$KEYDIR/password must be mode 0600"

cd "$dir"
rm -f SHA256SUMS SHA256SUMS.sig
find . -maxdepth 1 -type f ! -name 'SHA256SUMS*' -printf '%f\n' | LC_ALL=C sort | xargs sha256sum > SHA256SUMS
COSIGN_PASSWORD=$(cat "$KEYDIR/password") cosign sign-blob --yes --key "$KEYDIR/cosign.key" \
  --use-signing-config=false --tlog-upload=false --bundle SHA256SUMS.sig SHA256SUMS >/dev/null
cosign verify-blob --key "$HERE/cosign.pub" --bundle SHA256SUMS.sig --insecure-ignore-tlog SHA256SUMS >/dev/null 2>&1
chmod 644 SHA256SUMS.sig
echo "signed $dir ($(wc -l < SHA256SUMS) files)"
