#!/usr/bin/env bash
set -euo pipefail
. "$(dirname "$0")/lib.sh"
need syft grype guestmount guestunmount jq
out=${1:?usage: sbom <output-dir>}
export LIBGUESTFS_BACKEND=direct
mnt=$(mktemp -d)
cleanup() { mountpoint -q "$mnt" && guestunmount "$mnt" || true; rmdir "$mnt" 2>/dev/null || true; }
trap cleanup EXIT

while read -r manifest; do
  [ -n "$manifest" ] || continue
  img=$out/$(jq -r .file "$manifest")
  base=${img%.qcow2}
  name=$(jq -r '.name + "-" + .version' "$manifest")
  if [ -z "${FORCE:-}" ] && [ "$base.vulns-summary.json" -nt "$img" ]; then echo "sbom $(basename "$img") up to date"; continue; fi
  echo "sbom $(basename "$img")"
  guestmount -a "$img" -i --ro "$mnt"
  syft scan "dir:$mnt" --source-name "$name" -o "spdx-json=$base.spdx.json" -q
  guestunmount "$mnt"
  grype "sbom:$base.spdx.json" -o json -q > "$base.vulns.json"
  jq '[.matches[].vulnerability.severity] | group_by(.) | map({key: .[0], value: length}) | from_entries
      | {Critical: (.Critical // 0), High: (.High // 0), Medium: (.Medium // 0), Low: (.Low // 0), Negligible: (.Negligible // 0), Unknown: (.Unknown // 0)}' \
    "$base.vulns.json" > "$base.vulns-summary.json"
  echo "  $(jq -c . "$base.vulns-summary.json")"
done < <(selected_manifests "$out")
