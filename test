#!/usr/bin/env python3
import argparse
import base64
import json
import os
import secrets
import shlex
import shutil
import socket
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.abspath(__file__))
HOSTNAME = "vmarea-test-hostname-0123"
FQDN = HOSTNAME + ".example.com"
GiB = 1024 ** 3

results = []
BSD = False


def record(name, ok, detail=""):
    results.append((name, ok))
    line = f"{'PASS' if ok else 'FAIL'} {name}"
    if detail and not ok:
        line += f": {detail}"
    print(line, flush=True)


def check(name, fn):
    try:
        res = fn()
        if res is True or res is None:
            record(name, True)
        else:
            record(name, False, str(res))
    except Exception as e:
        record(name, False, f"{type(e).__name__}: {e}")


def free_port():
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


class VM:
    def __init__(self, label, image, workdir, key, mac, overlay_size=None, overlay=None):
        self.label = label
        self.dir = os.path.join(workdir, label)
        os.makedirs(self.dir, exist_ok=True)
        self.key = key
        self.mac = mac
        self.uuid = "5a1b2c3d-0000-4000-8000-" + mac.replace(":", "") + ""
        self.port = free_port()
        self.sock = os.path.join(self.dir, "qga.sock")
        self.proc = None
        self.overlay = overlay or os.path.join(self.dir, "disk.qcow2")
        if overlay is None:
            r = run(["qemu-img", "create", "-f", "qcow2", "-b", os.path.abspath(image), "-F", "qcow2", self.overlay, "20G"])
            if r.returncode != 0:
                raise RuntimeError(r.stderr)

    def make_seed(self, instance_id, password, package_upgrade):
        pub = open(self.key + ".pub").read().strip()
        ud = [
            "#cloud-config",
            f"hostname: {HOSTNAME}",
            "manage_etc_hosts: true",
            f"fqdn: {FQDN}",
            "user: root",
            "disable_root: False",
            f"password: {json.dumps(password)}",
            "chpasswd:",
            "  expire: False",
        ]
        if package_upgrade:
            ud.append("package_upgrade: true")
        ud += ["ssh_authorized_keys:", f"  - {json.dumps(pub)}"]
        nc = [
            "version: 1",
            "config:",
            "    - type: physical",
            "      name: eth0",
            f"      mac_address: '{self.mac}'",
            "      subnets:",
            "      - type: dhcp4",
            "    - type: nameserver",
            "      address:",
            "      - '1.1.1.1'",
            "      search:",
            "      - 'example.com'",
        ]
        files = {"user-data": "\n".join(ud) + "\n", "meta-data": f"instance-id: {instance_id}\n", "network-config": "\n".join(nc) + "\n"}
        for n, c in files.items():
            with open(os.path.join(self.dir, n), "w") as f:
                f.write(c)
        seed = os.path.join(self.dir, f"seed-{instance_id[:8]}.iso")
        r = run(["cloud-localds", "-N", os.path.join(self.dir, "network-config"), seed,
                 os.path.join(self.dir, "user-data"), os.path.join(self.dir, "meta-data")])
        if r.returncode != 0:
            raise RuntimeError(r.stderr)
        return seed

    def start(self, seed):
        if os.path.exists(self.sock):
            os.remove(self.sock)
        cmd = [
            "qemu-system-x86_64", "-enable-kvm", "-cpu", "host", "-smp", "2", "-m", "2048",
            "-display", "none", "-vga", "std",
            "-serial", f"file:{self.dir}/console.log",
            "-device", "virtio-scsi-pci,id=scsi0",
            "-drive", f"file={self.overlay},if=none,id=drive0,format=qcow2,discard=unmap",
            "-device", "scsi-hd,drive=drive0,bus=scsi0.0",
            "-drive", f"file={seed},if=none,id=cd0,media=cdrom,readonly=on",
            "-device", "ide-cd,drive=cd0",
            "-uuid", self.uuid,
            "-netdev", f"user,id=n0,hostfwd=tcp:127.0.0.1:{self.port}-:22",
            "-device", f"virtio-net-pci,netdev=n0,mac={self.mac}",
            "-chardev", f"socket,path={self.sock},server=on,wait=off,id=qga0",
            "-device", "virtio-serial",
            "-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0",
        ]
        self.proc = subprocess.Popen(cmd, stdout=open(f"{self.dir}/qemu.log", "ab"), stderr=subprocess.STDOUT)

    def kill(self):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(10)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait()

    def _ssh_base(self):
        return ["ssh", "-p", str(self.port), "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
                "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=10", "-o", "ServerAliveInterval=15"]

    def ssh(self, command, password=None, timeout=120):
        if BSD:
            command = "sh -c " + shlex.quote(command)
        if password is None:
            cmd = self._ssh_base() + ["-i", self.key, "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes", "root@127.0.0.1", command]
            env = None
        else:
            cmd = ["sshpass", "-e"] + self._ssh_base() + ["-o", "PreferredAuthentications=password", "-o", "PubkeyAuthentication=no",
                                                           "root@127.0.0.1", command]
            env = dict(os.environ, SSHPASS=password)
        return run(cmd, timeout=timeout, env=env)

    def wait_ssh(self, timeout=300):
        end = time.time() + timeout
        while time.time() < end:
            if self.proc.poll() is not None:
                raise RuntimeError("qemu exited")
            try:
                if self.ssh("true", timeout=30).returncode == 0:
                    return
            except subprocess.TimeoutExpired:
                pass
            time.sleep(3)
        raise TimeoutError("ssh did not come up")

    def wait_cloud_init(self, timeout=900):
        end = time.time() + timeout
        last = ""
        while time.time() < end:
            try:
                r = self.ssh("cloud-init status --wait --format json", timeout=600)
            except subprocess.TimeoutExpired:
                continue
            if r.stdout.strip().startswith("{"):
                return json.loads(r.stdout)
            last = r.stdout + r.stderr
            time.sleep(3)
        raise TimeoutError("cloud-init did not finish: " + last)

    def qga(self, execute, arguments=None, timeout=15):
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(timeout)
        try:
            s.connect(self.sock)
            sid = secrets.randbelow(2 ** 30)
            s.sendall(b"\xff" + json.dumps({"execute": "guest-sync-delimited", "arguments": {"id": sid}}).encode() + b"\n")
            buf = b""

            def read_line():
                nonlocal buf
                while b"\n" not in buf:
                    chunk = s.recv(65536)
                    if not chunk:
                        raise ConnectionError("agent socket closed")
                    buf += chunk
                line, buf = buf.split(b"\n", 1)
                return line

            while b"\xff" not in buf:
                chunk = s.recv(65536)
                if not chunk:
                    raise ConnectionError("agent socket closed")
                buf += chunk
            buf = buf.split(b"\xff", 1)[1]
            if json.loads(read_line()).get("return") != sid:
                raise RuntimeError("agent sync mismatch")
            req = {"execute": execute}
            if arguments:
                req["arguments"] = arguments
            s.sendall(json.dumps(req).encode() + b"\n")
            resp = json.loads(read_line())
            if "error" in resp:
                raise RuntimeError(f"{execute}: {resp['error'].get('desc')}")
            return resp.get("return")
        finally:
            s.close()

    def wait_agent(self, timeout=180):
        end = time.time() + timeout
        while time.time() < end:
            try:
                self.qga("guest-ping", timeout=5)
                return True
            except Exception:
                time.sleep(3)
        return False

    def qga_exec(self, path, args, timeout=60):
        pid = self.qga("guest-exec", {"path": path, "arg": args, "capture-output": True})["pid"]
        end = time.time() + timeout
        while time.time() < end:
            st = self.qga("guest-exec-status", {"pid": pid})
            if st.get("exited"):
                out = base64.b64decode(st.get("out-data", "")).decode(errors="replace")
                return st.get("exitcode"), out
            time.sleep(1)
        raise TimeoutError("guest-exec did not finish")

    def host_keys(self):
        r = self.ssh("for f in /etc/ssh/ssh_host_*_key.pub; do ssh-keygen -lf $f; done")
        return set(l.split()[1] for l in r.stdout.splitlines() if l.strip())


def wait_marker(vm, timeout=900):
    end = time.time() + timeout
    while time.time() < end:
        unit_cmd = "pgrep -f vmarea-first-boot-update >/dev/null && echo active" if BSD else "systemctl is-active vmarea-first-boot-update 2>&1"
        r = vm.ssh("cat /var/lib/vmarea/first-boot-update 2>/dev/null; echo ---; " + unit_cmd)
        marker, _, unit = r.stdout.partition("---")
        if marker.strip():
            return marker.strip()
        if unit.strip() not in ("active", "activating"):
            return None
        time.sleep(5)
    return None


def shutdown(vm):
    try:
        vm.ssh("poweroff", timeout=30)
    except Exception:
        pass
    try:
        vm.proc.wait(60)
    except subprocess.TimeoutExpired:
        vm.kill()


def static_checks(image):
    import hashlib
    with open(os.path.join(ROOT, "files", "README.txt"), "rb") as f:
        sha = hashlib.sha256(f.read()).hexdigest()
    script = r"""
H='# Managed by VMArea. See /etc/vmarea/README.txt'
sum=$(sha256sum /etc/vmarea/README.txt 2>/dev/null | cut -d' ' -f1)
[ "$sum" = "SHA" ] || echo "readme: missing or different"
for f in /etc/cloud/cloud.cfg.d/90-vmarea.cfg /etc/ssh/sshd_config.d/00-vmarea.conf /usr/local/sbin/vmarea-swap /usr/local/sbin/vmarea-first-boot-update /var/lib/cloud/scripts/per-once/10-vmarea-first-boot-update /etc/vmarea/image.conf; do
  head -3 "$f" 2>/dev/null | grep -qxF "$H" || echo "header: $f"
done
for f in /etc/sysconfig/qemu-ga /etc/default/qemu-guest-agent /etc/dracut.conf.d/90-vmarea.conf /etc/mkinitcpio.conf.d/vmarea.conf; do
  if [ -f "$f" ]; then head -3 "$f" | grep -qxF "$H" || echo "header: $f"; fi
done
ls -A /root | while read f; do
  case "$f" in .bashrc|.bash_profile|.bash_logout|.cshrc|.tcshrc|.profile) ;; *) echo "root: $f" ;; esac
done
find /root /home -name '*_history' | sed 's/^/history: /'
ls -A /home | sed 's/^/home: /'
ls -A /tmp /var/tmp | grep -v ':$' | grep -v '^$' | sed 's/^/tmp: /'
[ ! -s /etc/machine-id ] || echo "machine-id not empty"
ls /etc/ssh/ssh_host_* 2>/dev/null | sed 's/^/hostkey: /'
ls -A /var/log/journal 2>/dev/null | sed 's/^/journal: /'
find /var/log -type f -size +0 ! -name lastlog ! -name wtmp ! -name btmp ! -name faillog | head -5 | sed 's/^/log: /'
ls -A /var/lib/cloud | grep -vx scripts | sed 's/^/cloud-state: /'
ls / | grep '^vmarea-' | sed 's/^/build-file: /'
find /var/cache /var/lib/apt/lists /var/lib/pacman/sync -type f 2>/dev/null | grep -E '[.](deb|rpm)$|[.]pkg[.]tar|Packages|repomd[.]xml|[.]db$' | head -3 | sed 's/^/cache: /'
""".replace("SHA", sha)
    env = dict(os.environ, LIBGUESTFS_BACKEND="direct")
    r = subprocess.run(["guestfish", "--ro", "-a", image, "-i", "sh-lines", script], capture_output=True, text=True, env=env, timeout=300)
    if r.returncode != 0:
        record("image_static_checks", False, r.stderr.strip()[-300:])
        return
    findings = [l for l in r.stdout.splitlines() if l.strip()]
    groups = {
        "image_vmarea_files": ("readme:", "header:"),
        "image_no_traces": ("root:", "history:", "home:", "tmp:", "machine-id", "hostkey:", "journal:", "log:", "cloud-state:", "build-file:", "cache:"),
    }
    for name, prefixes in groups.items():
        bad = [l for l in findings if l.startswith(prefixes)]
        record(name, not bad, "; ".join(bad[:8]))
    try:
        with open(os.path.splitext(image)[0] + ".json") as f:
            m = json.load(f)
    except OSError:
        return
    p = m.get("pending_updates_after_build")
    if p is not None:
        record("manifest_no_pending_updates", p == 0, f"pending_updates_after_build={p}")


def main():
    ap = argparse.ArgumentParser(description="Boot a built image and check it behaves like a VMArea instance")
    ap.add_argument("image")
    ap.add_argument("--no-package-upgrade", action="store_true", help="omit package_upgrade from the seed")
    ap.add_argument("--keep", action="store_true", help="keep the work directory")
    ap.add_argument("--workdir", default=os.path.join(ROOT, ".testrun"))
    args = ap.parse_args()
    global BSD
    BSD = os.path.basename(args.image).startswith("freebsd-")

    work = os.path.join(os.path.abspath(args.workdir), f"{os.path.basename(args.image)}-{os.getpid()}")
    os.makedirs(work, exist_ok=True)
    key = os.path.join(work, "id_ed25519")
    subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", key], check=True)
    pw1, pw2 = secrets.token_urlsafe(14), secrets.token_urlsafe(14)
    pkg_up = not args.no_package_upgrade
    a = b = None
    started = time.time()
    try:
        if not BSD:
            static_checks(os.path.abspath(args.image))
        a = VM("a", args.image, work, key, "52:54:00:aa:00:01")
        b = VM("b", args.image, work, key, "52:54:00:aa:00:02")
        iid_a, iid_b = secrets.token_hex(20), secrets.token_hex(20)
        a.start(a.make_seed(iid_a, pw1, pkg_up))
        b.start(b.make_seed(iid_b, pw1, pkg_up))

        up = {}
        for vm in (a, b):
            try:
                vm.wait_ssh()
                up[vm.label] = True
            except Exception as e:
                up[vm.label] = False
                record(f"boot_ssh_key_{vm.label}", False, str(e))
        if not up["a"]:
            raise SystemExit(finish())
        record("boot_ssh_key", True)

        ci = {}

        def cloud_init(vm):
            def f():
                st = vm.wait_cloud_init()
                ci[vm.label] = st
                errs = list(st.get("errors") or []) + list(st.get("recoverable_errors", {}).get("ERROR", []) if isinstance(st.get("recoverable_errors"), dict) else [])
                if st.get("status") != "done" or errs:
                    return f"status={st.get('status')} errors={errs}"
            return f

        check("cloud_init_done_no_errors", cloud_init(a))
        if up.get("b"):
            try:
                b.wait_cloud_init()
            except Exception:
                pass

        check("ssh_password_login", lambda: (lambda r: True if r.returncode == 0 and r.stdout.strip() == "pwok" else f"rc={r.returncode} {r.stderr.strip()}")(a.ssh("echo pwok", password=pw1)))
        check("hostname", lambda: (lambda h: True if h == HOSTNAME else f"got {h!r}")(a.ssh("uname -n").stdout.strip()))

        if BSD:
            check("fqdn", lambda: True if a.ssh("grep -c " + FQDN + " /etc/hosts").stdout.strip() not in ("", "0") else "fqdn not in /etc/hosts")
        else:
            check("fqdn", lambda: (lambda h: True if h == FQDN else f"got {h!r}")(a.ssh("hostname -f 2>/dev/null || getent hosts $(uname -n) | head -1 | awk '{print $2}'").stdout.strip()))

        def disk():
            size = int(a.ssh("df -kP / | tail -1 | awk '{print $2}'").stdout.strip()) * 1024
            return True if size > 17 * GiB else f"root fs {size / GiB:.2f} GiB"

        check("root_fs_grown", disk)

        def net_bsd():
            route = a.ssh("netstat -rn -f inet | grep '^default'").stdout
            link = a.ssh("ifconfig eth0").returncode
            if link != 0:
                return "no interface named eth0"
            if "eth0" not in route:
                return f"default route: {route.strip()!r}"

        def net():
            link = a.ssh("ip -o link show eth0").returncode
            route = a.ssh("ip route show default").stdout
            if link != 0:
                return "no interface named eth0"
            if "dev eth0" not in route:
                return f"default route: {route.strip()!r}"

        check("nic_eth0_default_route", net_bsd if BSD else net)
        check("dns_resolves", lambda: True if a.ssh("getent hosts example.com").returncode == 0 else "getent failed")

        def first_boot():
            m = wait_marker(a)
            if m is None:
                return "first-boot update marker missing"
            parts = m.split()
            if len(parts) < 2 or parts[1] != "0":
                return f"marker {m!r}"

        check("first_boot_update", first_boot)

        def agent():
            if not a.wait_agent():
                return "no answer to guest-ping"

        check("agent_ping", agent)
        check("agent_osinfo", lambda: True if a.qga("guest-get-osinfo").get("name") else "empty osinfo")

        def exec_ok():
            code, out = a.qga_exec("/bin/sh", ["-c", "echo ok"])
            return True if code == 0 and out.strip() == "ok" else f"code={code} out={out!r}"

        check("agent_exec", exec_ok)
        check("agent_network_interfaces", lambda: True if any(i.get("name") == "eth0" for i in a.qga("guest-network-get-interfaces")) else "eth0 missing")
        check("agent_fsfreeze_status", lambda: True if a.qga("guest-fsfreeze-status") == "thawed" else "unexpected status")

        def file_ops():
            h = a.qga("guest-file-open", {"path": "/tmp/vmarea-qga-test", "mode": "w"})
            a.qga("guest-file-write", {"handle": h, "buf-b64": base64.b64encode(b"qga-file-ok").decode()})
            a.qga("guest-file-close", {"handle": h})
            got = a.ssh("cat /tmp/vmarea-qga-test").stdout.strip()
            return True if got == "qga-file-ok" else f"read back {got!r}"

        check("agent_file_ops", file_ops)

        keys_a = {}

        def keys():
            keys_a["a"] = a.host_keys()
            keys_a["b"] = b.host_keys() if up.get("b") else set()
            if not keys_a["a"]:
                return "no host keys"
            if not keys_a["b"]:
                return "second instance has no host keys"
            if keys_a["a"] & keys_a["b"]:
                return "host keys shared between instances"

        check("ssh_host_keys_unique_per_instance", keys)

        def mid():
            f = "/etc/hostid" if BSD else "/etc/machine-id"
            ma = a.ssh("cat " + f).stdout.strip()
            mb = b.ssh("cat " + f).stdout.strip()
            return True if ma and mb and ma != mb else f"machine-id a={ma!r} b={mb!r}"

        check("machine_id_unique_per_instance", mid)

        def console_bsd():
            g = a.ssh("grep -c '^ttyv0.*getty.*on' /etc/ttys; ps -ax | grep -c '[g]etty'").stdout.split()
            h = a.ssh("pw usershow root | cut -d: -f2").stdout.strip()
            if len(g) < 2 or g[0] == "0" or g[1] == "0":
                return f"getty on ttyv0 not running: {g}"
            if not h.startswith("$"):
                return "root has no usable password hash"

        def console():
            g = a.ssh("systemctl is-active getty@tty1").stdout.strip()
            p = a.ssh("passwd -S root").stdout.split()
            if g != "active":
                return f"getty@tty1 is {g!r}"
            if len(p) < 2 or p[1] not in ("P", "PS"):
                return f"root password status {p[1:2]}"

        check("console_getty_root_password", console_bsd if BSD else console)

        def swap():
            kb = int(a.ssh("awk '/^MemTotal:/ {print $2}' /proc/meminfo").stdout.strip())
            want = 1 * GiB if kb <= 2 * 1024 * 1024 else 2 * GiB if kb <= 8 * 1024 * 1024 else 0
            out = a.ssh("swapon --show=NAME,SIZE --noheadings --bytes").stdout.split()
            if want == 0:
                return True if not out else f"unexpected swap {out}"
            if out[:1] and out[0] != "/swapfile" and int(out[1]) > 0 and a.ssh("grep -c '^/swapfile ' /etc/fstab").stdout.strip() == "0":
                return True
            if out[:1] != ["/swapfile"] or abs(int(out[1]) - want) > 16 * 1024 * 1024:
                return f"swapon shows {out}, want /swapfile {want}"
            if a.ssh("grep -c '^/swapfile ' /etc/fstab").stdout.strip() != "1":
                return "no fstab entry"
            if a.ssh("stat -c %a /swapfile").stdout.strip() != "600":
                return "swapfile mode is not 600"

        if not BSD:
            check("swapfile_active", swap)

        def pkgs():
            osid = a.ssh(". /etc/os-release; echo $ID").stdout.strip()
            cmds = ["curl", "wget", "nano", "unzip"]
            if osid not in ("almalinux", "rocky", "centos"):
                cmds.append("htop")
            r = a.ssh("for c in " + " ".join(cmds) + "; do command -v $c >/dev/null || echo missing:$c; done; "
                      "command -v vi >/dev/null || command -v vim >/dev/null || command -v vim.tiny >/dev/null || echo missing:vim; "
                      "test -f /usr/share/bash-completion/bash_completion || echo missing:bash-completion; "
                      "test -s /etc/ssl/certs/ca-certificates.crt -o -s /etc/pki/tls/certs/ca-bundle.crt -o -s /etc/ssl/ca-bundle.pem || echo missing:ca-certificates")
            return True if not r.stdout.strip() else r.stdout.strip().replace(chr(10), " ")

        def pkgs_bsd():
            r = a.ssh("for c in curl nano htop bash; do command -v $c >/dev/null || echo missing:$c; done; test -s /usr/local/share/certs/ca-root-nss.crt || echo missing:ca_root_nss")
            return True if not r.stdout.strip() else r.stdout.strip().replace(chr(10), " ")

        check("extra_packages_present", pkgs_bsd if BSD else pkgs)

        def firewall():
            r = a.ssh("for u in firewalld ufw; do systemctl is-enabled $u 2>/dev/null; systemctl is-active $u 2>/dev/null; done; true").stdout.split()
            bad = [x for x in r if x in ("enabled", "active")]
            return True if not bad else f"firewall service state: {bad}"

        def firewall_bsd():
            r = a.ssh("sysrc -n pf_enable ipfw_enable firewall_enable 2>/dev/null; true").stdout.split()
            return True if "YES" not in [x.upper() for x in r] else f"firewall enabled: {r}"

        check("firewall_off", firewall_bsd if BSD else firewall)

        def tz_locale():
            tz = a.ssh("date +%Z").stdout.strip()
            if BSD:
                return True if tz == "UTC" else f"timezone {tz!r}"
            loc = a.ssh("localectl status 2>/dev/null | grep -i 'System Locale'; cat /etc/default/locale /etc/locale.conf 2>/dev/null").stdout
            have = a.ssh("locale -a").stdout.lower()
            if tz != "UTC":
                return f"timezone {tz!r}"
            if "en_us.utf-8" not in loc.lower():
                return f"locale config {loc!r}"
            if "en_us.utf8" not in have and "en_us.utf-8" not in have:
                return "en_US.UTF-8 locale not generated"

        check("timezone_locale", tz_locale)

        def bsd_managed_files():
            readme = a.ssh("cat /etc/vmarea/README.txt").stdout
            want = "These files let the control panel set your password, hostname and network, and run startup scripts. Removing or changing them can stop those features working. We cannot support servers where they were changed."
            if want not in readme:
                return "README.txt missing or wrong text"
            hdr = "# Managed by VMArea. See /etc/vmarea/README.txt"
            files = [l.strip() for l in readme.splitlines() if l.startswith("/")]
            if "/etc/vmarea/README.txt" not in files or len(files) < 5:
                return f"README file list incomplete: {files}"
            bad = []
            for f in files:
                if f == "/etc/vmarea/README.txt":
                    continue
                if hdr not in a.ssh("head -3 " + f).stdout:
                    bad.append(f)
            if hdr not in a.ssh("head -3 /etc/ssh/sshd_config").stdout:
                bad.append("/etc/ssh/sshd_config")
            if bad:
                return f"missing header: {bad}"
            hist = a.ssh("ls -a /root | grep -E '(history|_history)$'").stdout.strip()
            if hist:
                return f"shell history present: {hist}"

        if BSD:
            check("vmarea_files_readme_headers_no_history", bsd_managed_files)

        b.kill()
        shutdown(a)
        iid_a2 = secrets.token_hex(20)
        a.start(a.make_seed(iid_a2, pw2, pkg_up))
        try:
            a.wait_ssh()
            a.wait_cloud_init()
        except Exception as e:
            record("reset_boot", False, str(e))
        else:
            check("reset_new_password_works", lambda: (lambda r: True if r.returncode == 0 else f"rc={r.returncode} {r.stderr.strip()}")(a.ssh("true", password=pw2)))
            check("reset_old_password_rejected", lambda: True if a.ssh("true", password=pw1).returncode != 0 else "old password still accepted")
            check("reset_host_keys_unchanged", lambda: True if a.host_keys() == keys_a["a"] else "host keys changed after reset")
            check("reset_hostname_unchanged", lambda: (lambda h: True if h == HOSTNAME else f"got {h!r}")(a.ssh("uname -n").stdout.strip()))
    finally:
        for vm in (a, b):
            if vm:
                vm.kill()
        if not args.keep:
            shutil.rmtree(work, ignore_errors=True)
    return finish(started)


def finish(started=None):
    failed = [n for n, ok in results if not ok]
    took = f" in {int(time.time() - started)}s" if started else ""
    print(f"{len(results) - len(failed)} passed, {len(failed)} failed{took}")
    return 1 if failed else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit as e:
        sys.exit(e.code if isinstance(e.code, int) else 1)
