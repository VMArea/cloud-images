def render(rows, generated):
    e = html.escape
    tag = os.environ.get("RELEASE_TAG", "")
    out = [
        "<!doctype html>",
        '<html lang="en"><head><meta charset="utf-8">',
        '<meta name="viewport" content="width=device-width,initial-scale=1">',
        "<title>Cloud images | VMArea</title>",
        '<meta name="description" content="Tested, signed cloud images for KVM and QEMU with cloud-init. Rebuilt every month.">',
        f"<style>{CSS}</style></head><body>",
        f'<div class="top"><a class="brand" href="https://vmarea.com">{LOGO}VMArea</a>'
        f'<nav><a href="{REPO}#quick-start">Quick start</a><a href="{REPO}">GitHub</a></nav></div>',
        '<section class="hero"><h1>Cloud images, <em>tested and signed.</em></h1>',
        "<p>For KVM and QEMU with cloud-init. Rebuilt every month.</p>",
        f'<div class="meta">{"Release " + e(tag) + " / " if tag else ""}Updated {e(generated)}</div></section><main>',
    ]
    groups = {}
    for r in rows:
        groups.setdefault(r["os"], []).append(r)
    for osn in sorted(groups, key=lambda k: NAMES.get(k, k).lower()):
        out.append(f'<section class="os"><h2>{e(NAMES.get(osn, osn))}</h2>')
        def vkey(r):
            try:
                return tuple(int(x) for x in r["version"].split("."))
            except ValueError:
                return (0,)
        for r in sorted(groups[osn], key=vkey, reverse=True):
            v = r["vulnerabilities"]
            test = r["test"]
            facts = [f"Built {e(r['build_date'][:10])}", e(size(r["size_bytes"]))]
            facts.append('<span class="pill ok">Tested</span>' if test == "pass" else f'<span class="pill bad">Test {e(test)}</span>')
            if v is None:
                facts.append('<span class="pill warn">No scan</span>')
            elif v["Critical"] or v["High"]:
                facts.append(f'<span class="pill warn">{v["Critical"]} critical, {v["High"]} high fixed since build</span>')
            else:
                facts.append('<span class="pill ok">Up to date</span>')
            L = r["links"]
            links = [(L["checksums"], "Checksums"), (L["signature"], "Signature"), (L["sbom"], "SBOM"),
                     (L["vulnerabilities"], "Scan report"), (L["changes"], "Changes")]
            link_html = "".join(f'<a href="{e(u)}">{t}</a>' for u, t in links if u)
            out.append(
                f'<div class="row"><div class="ver">{e(r["version"])}</div>'
                f'<div><div class="facts">{" ".join(facts)}</div><div class="links">{link_html}</div></div>'
                f'<a class="btn" href="{e(L["download"])}">Download</a></div>'
            )
        out.append("</section>")
    out += [
        "</main><footer>",
        "<p><strong>Fixed since build</strong> counts security fixes the distribution released after the image was built. "
        "The first-boot update installs them, and the next monthly build includes them.</p>",
        f'<p>Check every download against the signed <code>SHA256SUMS</code>, see the <a href="{REPO}#quick-start">quick start</a>. '
        f'Source and recipes on <a href="{REPO}">GitHub</a>, MIT licence. Ubuntu and Windows images are not published.</p>',
        "</footer></body></html>",
    ]
    return "\n".join(out) + "\n"


def main():
    root = sys.argv[1]
    rows = collect(root)
    gen = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    with open(os.path.join(root, "index.html"), "w") as f:
        f.write(render(rows, gen))
    with open(os.path.join(root, "index.json"), "w") as f:
        json.dump({"generated": gen, "images": rows}, f, indent=2)
        f.write("\n")
    print(f"status {len(rows)} images -> {root}/index.html")


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("usage: status <stage-dir>")
    main()
