def render(rows, generated):
    e = html.escape
    heads = ["OS", "Version", "Build date", "Size", "SHA-256", "Test"] + [f"Fixable {s.lower()}" for s in SEV] + ["Files"]
    out = [
        "<!doctype html>",
        '<html lang="en"><head><meta charset="utf-8">',
        '<meta name="viewport" content="width=device-width,initial-scale=1">',
        "<title>VMArea cloud images</title>",
        f"<style>{CSS}</style></head><body>",
        '<header><span class="wm">VMArea</span></header><main>',
        "<h1>Cloud images</h1>",
        f"<p>Latest build per release. Generated {e(generated)}. Verify downloads with SHA256SUMS and SHA256SUMS.sig.</p>",
        '<div class="wrap"><table><caption>Latest cloud images</caption><thead><tr>',
        "".join(f'<th scope="col">{h}</th>' for h in heads),
        "</tr></thead><tbody>",
    ]
    for r in rows:
        v = r["vulnerabilities"]
        cls = "pass" if r["test"] == "pass" else "fail" if r["test"] == "fail" else ""
        cells = [
            (e(r["os"]), ""),
            (e(r["version"]), ""),
            (e(r["build_date"][:10]), ""),
            (e(size(r["size_bytes"])), ""),
            (f"<code>{e(r['sha256'] or '')}</code>", ""),
            (f'<span class="{cls}">{e(r["test"])}</span>', ""),
        ]
        for s in SEV:
            cells.append((str(v[s]) if v else "n/a", "n"))
        L = r["links"]
        items = [f'<li><a href="{e(L["download"])}">Image</a></li>']
        for k, label in [("sbom", "SBOM"), ("vulnerabilities", "Vulnerabilities"), ("changes", "Changes"), ("checksums", "SHA256SUMS"), ("signature", "Signature")]:
            if L[k]:
                items.append(f'<li><a href="{e(L[k])}">{label}</a></li>')
        tot = r["vulnerabilities_total"]
        detail = ""
        if tot:
            detail = "<small>All matches incl. unfixed (" + e(r["distro"] or "") + "): " + ", ".join(f"{tot[s]} {s.lower()}" for s in SEV) + "</small>"
        cells.append(('<ul class="l">' + "".join(items) + "</ul>" + detail, ""))
        out.append("<tr>" + "".join(f'<td class="{c}">{t}</td>' if c else f"<td>{t}</td>" for t, c in cells) + "</tr>")
    out += [
        "</tbody></table></div></main>",
        "<footer>Severity columns count vulnerabilities with a fix in the distro repositories (grype --only-fixed on the image SBOM at build time). The full list is in the vulnerabilities file.</footer>",
        "</body></html>",
    ]
    return "\n".join(out) + "\n"


def main():
    root = sys.argv[1]
    rows = collect(root)
    gen = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    with open(os.path.join(root, "index.html"), "w") as f:
        f.write(render(rows, gen))
    with open(os.path.join(root, "index.json"), "w") as f:
        json.dump({"generated": gen, "images": rows}, f, indent=2)
        f.write("\n")
    print(f"status {len(rows)} images -> {root}/index.html")


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("usage: status <stage-dir>")
    main()
