def check(name, ok, detail=""):
    results.append((name, bool(ok)))
    print(("PASS " if ok else "FAIL ") + name + ((" - " + str(detail)) if detail and not ok else ""), flush=True)
    return ok


def sh(*a, **kw):
    return subprocess.run(a, check=True, **kw)


def config_drive(path, stage, instance, password):
    if os.path.exists(stage):
        shutil.rmtree(stage)
    meta = {
        "uuid": instance, "hostname": HOSTNAME, "name": HOSTNAME, "admin_pass": password, "launch_index": 0,
        "availability_zone": "nova", "meta": {}, "public_keys": {}, "project_id": "vmarea",
        "network_config": {"content_path": "/content/0000", "link": "/dev/null"},
    }
    eni = "auto lo\niface lo inet loopback\n\nauto eth0\niface eth0 inet dhcp\n    hwaddress ether %s\n    dns-nameservers 1.1.1.1\n" % MAC
    ud = "#cloud-config\nhostname: %s\nfqdn: %s.vmarea.test\nmanage_etc_hosts: true\nuser: Administrator\npassword: %s\nchpasswd:\n  expire: False\n" % (HOSTNAME, HOSTNAME, password)
    for v in ("latest", "2012-08-10"):
        d = os.path.join(stage, "openstack", v)
        os.makedirs(d)
        with open(os.path.join(d, "meta_data.json"), "w") as f:
            json.dump(meta, f)
        with open(os.path.join(d, "user_data"), "w") as f:
            f.write(ud)
    os.makedirs(os.path.join(stage, "openstack", "content"))
    with open(os.path.join(stage, "openstack", "content", "0000"), "w") as f:
        f.write(eni)
    sh("genisoimage", "-quiet", "-V", "config-2", "-J", "-r", "-o", path, stage)


