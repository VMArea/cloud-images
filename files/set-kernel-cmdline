#!/bin/sh
[ -f /etc/kernel/cmdline ] && exit 0
entry=$(ls /boot/loader/entries/*.conf 2>/dev/null | grep -v rescue | head -1)
[ -n "$entry" ] || exit 0
opts=$(grep -h '^options' "$entry" | head -1 | sed 's/^options //')
[ -n "$opts" ] || exit 0
mkdir -p /etc/kernel
echo "$opts" > /etc/kernel/cmdline
exit 0
