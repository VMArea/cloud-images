def traces(vm):
    if not SECRETS_FILE or not os.path.exists(SECRETS_FILE):
        return []
    with open(SECRETS_FILE) as f:
        pws = json.load(f)
    rc, out, err = vm.qga.ps_retry(TRACE_PS % ",".join("'%s'" % p for p in pws), 1500)
    return json.loads(out.strip().splitlines()[-1])


def wait_cloudbase(vm, timeout=1500):
    end = time.time() + timeout
    last = ""
    stable = 0
    while time.time() < end:
        if not vm.alive():
            return False, "vm exited"
        try:
            if not vm.qga.ready():
                stable = 0
                time.sleep(5)
                continue
            rc, out, err = vm.qga.ps(STATE_PS, 60)
            st = json.loads(out.strip().splitlines()[-1])
            last = st
            if st["svc"] == "Stopped" and st["fresh"] and st["uptime"] > 60:
                stable += 1
                if stable >= 2:
                    return True, st
            else:
                stable = 0
        except (QGAError, ValueError, IndexError):
            stable = 0
        time.sleep(10)
    return False, last


def facts(vm):
    rc, out, err = vm.qga.ps_retry(FACTS_PS, 300)
    try:
        return json.loads(out.strip().splitlines()[-1])
    except ValueError:
        with open(os.path.join(vm.work, "facts.raw"), "w") as f:
            f.write(out[:200000] + "|||" + err[:5000])
        raise


def rdp_auth(password, port=RDP_PORT, user="Administrator"):
    exe = shutil.which("xfreerdp3") or shutil.which("xfreerdp")
    if not exe:
        return None
    ver3 = "xfreerdp3" in exe
    cert = "/cert:ignore" if ver3 else "/cert-ignore"
    r = subprocess.run([exe, "/v:127.0.0.1:%d" % port, "/u:" + user, "/p:" + password, "/auth-only", cert, "/sec:nla"],
                       capture_output=True, text=True, timeout=90)
    return r.returncode == 0


