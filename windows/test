        check("hostname unchanged after reset boot", f2["hostname"] == HOSTNAME, f2["hostname"])
        errs = [e for e in f2["errors"] if not any(k in e for k in BENIGN)]
        check("Cloudbase-Init log has no errors after reset boot", not errs, errs[:3])
        rdp = rdp_auth(pw2)
        if rdp is not None:
            check("RDP NLA login with the new password", rdp)
    except SystemExit:
        pass
    finally:
        try:
            vm.screenshot(os.path.join(work, "screen.ppm"))
            ppm_to_png(os.path.join(work, "screen.ppm"), os.path.join(work, "screen.png"))
        except Exception:
            pass
        vm.stop()
    failed = [n for n, ok in results if not ok]
    print("%d passed, %d failed (%ds)" % (len(results) - len(failed), len(failed), time.time() - t0))
    if not a.keep and not failed:
        shutil.rmtree(work, ignore_errors=True)
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
