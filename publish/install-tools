#!/usr/bin/env bash
set -euo pipefail
SYFT=1.55.0
GRYPE=0.121.0
COSIGN=3.1.4
GH=2.103.3
BIN="${PUBLISH_BIN:-$HOME/.local/bin}"
mkdir -p "$BIN"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cd "$tmp"

fetch() { curl -fsSL --retry 3 -o "$2" "$1"; }

verify() {
  local file=$1 sums=$2 want got
  want=$(awk -v f="$file" '$2==f || $2=="*"f {print $1; exit}' "$sums")
  [ -n "$want" ] || { echo "no checksum for $file" >&2; exit 1; }
  got=$(sha256sum "$file" | awk '{print $1}')
  [ "$want" = "$got" ] || { echo "checksum mismatch for $file" >&2; exit 1; }
  echo "verified $file"
}

for t in syft:$SYFT grype:$GRYPE; do
  n=${t%%:*}; v=${t##*:}
  f=${n}_${v}_linux_amd64.tar.gz
  fetch "https://github.com/anchore/$n/releases/download/v$v/$f" "$f"
  fetch "https://github.com/anchore/$n/releases/download/v$v/${n}_${v}_checksums.txt" "$n.sums"
  verify "$f" "$n.sums"
  tar -xzf "$f" "$n"
  install -m 0755 "$n" "$BIN/$n"
done

fetch "https://github.com/sigstore/cosign/releases/download/v$COSIGN/cosign-linux-amd64" cosign-linux-amd64
fetch "https://github.com/sigstore/cosign/releases/download/v$COSIGN/cosign_checksums.txt" cosign.sums
verify cosign-linux-amd64 cosign.sums
install -m 0755 cosign-linux-amd64 "$BIN/cosign"

f=gh_${GH}_linux_amd64.tar.gz
fetch "https://github.com/cli/cli/releases/download/v$GH/$f" "$f"
fetch "https://github.com/cli/cli/releases/download/v$GH/gh_${GH}_checksums.txt" gh.sums
verify "$f" gh.sums
tar -xzf "$f" "gh_${GH}_linux_amd64/bin/gh"
install -m 0755 "gh_${GH}_linux_amd64/bin/gh" "$BIN/gh"

"$BIN/syft" version | head -1
"$BIN/grype" version | head -1
"$BIN/cosign" version 2>&1 | grep -i gitversion
"$BIN/gh" --version | head -1
