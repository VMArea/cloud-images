#!/usr/bin/env python3
import datetime
import html
import json
import os
import re
import shutil
import sys


def load(p):
    try:
        with open(p) as f:
            return json.load(f)
    except OSError:
        return None


def collect(root):
    rows = []
    for osn in sorted(os.listdir(root)):
        odir = os.path.join(root, osn)
        if not os.path.isdir(odir):
            continue
        for ver in sorted(os.listdir(odir)):
            vdir = os.path.join(odir, ver)
            if not os.path.isdir(vdir):
                continue
            dates = sorted(d for d in os.listdir(vdir) if re.fullmatch(r"\d{8}", d))
            if not dates:
                continue
            date = dates[-1]
            d = os.path.join(vdir, date)
            stem = f"{osn}-{ver}-{date}"
            man = load(os.path.join(d, stem + ".json")) or {}
            test = load(os.path.join(d, stem + ".test.json")) or {}
            vul = load(os.path.join(d, stem + ".vulns-summary.json")) or {}
            rel = os.environ.get("DOWNLOAD_BASE") or f"{osn}/{ver}/{date}/"

            def link(suffix):
                return rel + stem + suffix if os.path.exists(os.path.join(d, stem + suffix)) else None

            rows.append({
                "os": osn,
                "version": ver,
                "build_date": man.get("build_date") or f"{date[:4]}-{date[4:6]}-{date[6:]}",
                "date": date,
                "file": stem + ".qcow2",
                "size_bytes": man.get("size_bytes"),
                "sha256": man.get("sha256"),
                "test": test.get("result", "not run"),
                "test_summary": test_summary(test.get("note")),
                "vulnerabilities": vul.get("fixable"),
                "vulnerabilities_total": vul.get("total"),
                "distro": vul.get("distro"),
                "links": {
                    "download": rel + stem + ".qcow2",
                    "sbom": link(".spdx.json"),
                    "vulnerabilities": link(".vulns.json"),
                    "changes": link(".changes.txt"),
                    "checksums": rel + "SHA256SUMS",
                    "signature": rel + "SHA256SUMS.sig",
                },
            })
    return rows


SITE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "site")


def test_summary(note):
    m = re.match(r"(\d+) passed, (\d+) failed", note or "")
    if not m:
        return None
    passed, failed = int(m.group(1)), int(m.group(2))
    return f"{passed} of {passed + failed} passed"


def render(rows, generated):
    data = {
        "release": os.environ.get("RELEASE_TAG", ""),
        "generated": generated,
        "images": rows,
    }
    items = "".join(
        f'<li><a href="{html.escape(r["links"]["download"])}">{html.escape(r["file"])}</a></li>' for r in rows
    )
    blob = json.dumps(data, separators=(",", ":")).replace("</", "<\\/")
    with open(os.path.join(SITE, "index.html")) as f:
        page = f.read()
    return page.replace("/*DATA*/", blob).replace('<ul id="all"></ul>', f'<ul id="all">{items}</ul>')


def main():
    root = sys.argv[1]
    rows = collect(root)
    gen = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    shutil.copytree(os.path.join(SITE, "fonts"), os.path.join(root, "fonts"), dirs_exist_ok=True)
    with open(os.path.join(root, "index.html"), "w") as f:
        f.write(render(rows, gen))
    with open(os.path.join(root, "index.json"), "w") as f:
        json.dump({"generated": gen, "images": rows}, f, indent=2)
        f.write("\n")
    print(f"status {len(rows)} images -> {root}/index.html")


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("usage: status <stage-dir>")
    main()
